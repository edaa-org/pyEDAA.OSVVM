{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://edaa-org.github.io/pyEDAA.OSVVM/Schemas/OSVVM-BuildIndex-0.1.schema.json",
	"title": "OSVVM build index, format version 0.1",
	"description": "The build index 'index.yml' OSVVM appends an entry to per build in an output directory. Derived from OSVVM's writer 'FinishBuildYaml' in 'OsvvmScriptsCreateYamlReports.tcl' and reader 'ReportIndex2Html.tcl'.",
	"type": "object",
	"required": ["Version", "Builds"],
	"properties": {
		"Version": {"description": "Version of the format.", "const": "0.1"},
		"Builds": {
			"description": "The builds, in the order OSVVM ran them.",
			"type": "array",
			"items": {"$ref": "#/$defs/Build"}
		}
	},
	"additionalProperties": false,
	"$defs": {
		"Build": {
			"description": "A build's summary.",
			"type": "object",
			"required": ["Name", "Directory", "Status", "Passed", "Failed", "Skipped", "Tests", "AnalyzeErrorCount", "SimulateErrorCount", "BuildErrorCode", "StartTime", "FinishTime", "ElapsedTime", "ToolName", "ToolVersion", "OsvvmVersion"],
			"properties": {
				"Name":               {"type": "string", "minLength": 1},
				"Directory":          {"description": "Directory of the build's reports, relative to the index.", "type": "string"},
				"Status":             {"enum": ["PASSED", "FAILED"]},
				"Passed":             {"type": "integer", "minimum": 0},
				"Failed":             {"type": "integer", "minimum": 0},
				"Skipped":            {"type": "integer", "minimum": 0},
				"Tests":              {"description": "Sum of passed, failed and skipped test cases.", "type": "integer", "minimum": 0},
				"AnalyzeErrorCount":  {"type": "integer", "minimum": 0},
				"SimulateErrorCount": {"type": "integer", "minimum": 0},
				"BuildErrorCode":     {"type": "integer"},
				"StartTime":          {"type": "string", "format": "date-time"},
				"FinishTime":         {"type": "string", "format": "date-time"},
				"ElapsedTime":        {"description": "Duration of the build in seconds.", "type": "number", "minimum": 0},
				"ToolName":           {"description": "Name of the simulator, followed by its arguments, if any.", "type": "string"},
				"ToolVersion":        {"type": "string"},
				"OsvvmVersion":       {"description": "OSVVM's version YYYY.MM, optionally followed by a revision letter.", "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{1,2}[a-z]?$"}
			},
			"additionalProperties": false
		}
	}
}
